MODEL_ID=qwen3.8-27b
HF_REPO=Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed
BACKEND=mtplx
# Own port so it can run next to qwen3.6-27b for an A/B before the switch.
PORT=8002
# Qwen3.8-27B model card, thinking mode. Unlike 3.6 it publishes no separate
# lower-temperature coding preset; re-measure before carrying 3.6's 0.6 over.
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
